# Copy this file to `.env` at the repo root and fill in real values.
# `.env` itself is gitignored — never commit it.

# ---------------------------------------------------------------------------
# scraper-service (Django)
# ---------------------------------------------------------------------------

# Optional Cookie header attached to outbound ESPN requests, used only as a
# fallback for bot-detection friction on ESPN's public soccer endpoints. Most
# requests work fine without it — leave empty unless you're hitting 403s.
ESPN_COOKIE_HEADER=

# MongoDB connection string. Inside the docker-compose network the host is
# the service name "mongo" (not "localhost") since containers resolve each
# other by service name.
MONGO_URI=mongodb://mongo:27017/pitchquery

# How old (in seconds) a cached ESPN snapshot can be before scraper-service's
# /latest endpoint reports it as stale. Default: 300.
SCRAPER_STALENESS_SECONDS=300

# ---------------------------------------------------------------------------
# api-gateway (Spring Boot)
# ---------------------------------------------------------------------------

# OpenAI API key used for the tool-calling loop behind POST /api/ask.
OPENAI_API_KEY=

# OpenAI model name used for the tool-calling loop.
OPENAI_MODEL=gpt-4o

# Base URL api-gateway uses to reach scraper-service's internal endpoints.
# Inside docker-compose this is the service name + port; if you run
# api-gateway outside of compose against a dockerized scraper-service,
# use http://localhost:8001 instead.
SCRAPER_SERVICE_BASE_URL=http://scraper-service:8001

# ---------------------------------------------------------------------------
# frontend (React + Redux Toolkit)
# ---------------------------------------------------------------------------

# Base URL the frontend dev server uses to reach api-gateway's POST /api/ask.
VITE_API_GATEWAY_BASE_URL=http://localhost:8080
